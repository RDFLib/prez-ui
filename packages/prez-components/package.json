{
    "name": "prez-components",
    "version": "4.3.2",
    "description": "A Vue.js component library for rendering RDF data for use with Prez UI",
    "type": "module",
    "license": "BSD-3-Clause",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RDFLib/prez-ui.git",
        "directory": "packages/prez-components"
    },
    "homepage": "https://github.com/RDFLib/prez-ui/tree/main/packages/prez-components#readme",
    "bugs": {
        "url": "https://github.com/RDFLib/prez-ui/issues"
    },
    "files": [
        "dist"
    ],
    "main": "./dist/prez-components.umd.cjs",
    "module": "./dist/prez-components.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/prez-components.js",
            "require": "./dist/prez-components.umd.cjs"
        },
        "./prez-components.css": {
            "import": "./dist/prez-components.css",
            "require": "./dist/prez-components.css"
        }
    },
    "types": "./dist/index.d.ts",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc && vite build",
        "types": "vue-tsc",
        "preview": "vite preview",
        "preinstall": "npx only-allow pnpm"
    },
    "peerDependencies": {
        "vue": "^3.0.0"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/vue-table": "^8.21.3",
        "@vueuse/core": "^14.4.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dagre": "^0.8.5",
        "dompurify": "^3.4.12",
        "echarts": "^6.1.0",
        "lucide-vue-next": "^1.0.0",
        "marked": "^18.0.7",
        "mermaid": "^11.16.0",
        "prez-lib": "workspace:*",
        "reka-ui": "^2.10.1",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "v-network-graph": "^0.9.23",
        "vue-echarts": "^8.0.1",
        "vue-router": "^5.2.0"
    },
    "devDependencies": {
        "@types/dagre": "^0.7.54",
        "@types/node": "^26.1.2",
        "@vitejs/plugin-vue": "^6.0.8",
        "concurrently": "^10.0.4",
        "typescript": "6.0.3",
        "vite": "^8.2.0",
        "vite-plugin-dts": "^5.0.3",
        "vue-tsc": "3.3.9"
    }
}
